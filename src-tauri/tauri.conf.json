{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Octopush",
  "version": "0.4.85",
  "identifier": "com.octopush.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Octopush",
        "label": "main",
        "width": 1400,
        "height": 900,
        "minWidth": 960,
        "minHeight": 600,
        "decorations": true,
        "transparent": false,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "fullscreen": false,
        "resizable": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "DeveloperTool",
    "shortDescription": "The IDE for Agentic Developers",
    "longDescription": "Octopush — eight arms, zero wasted tokens. A native IDE that treats agentic coding sessions as first-class citizens with real PTY terminals, token budgets, and multi-agent orchestration.",
    "externalBin": [
      "octopush-pty-server",
      "octopush-mcp",
      "octopush-run-worker"
    ],
    "fileAssociations": [
      {
        "ext": [
          "txt",
          "text",
          "log"
        ],
        "name": "Text",
        "description": "Plain text",
        "role": "Editor",
        "rank": "Alternate",
        "mimeType": "text/plain",
        "contentTypes": [
          "public.plain-text",
          "public.source-code",
          "public.json",
          "public.xml",
          "public.yaml",
          "net.daringfireball.markdown",
          "public.comma-separated-values-text",
          "public.tab-separated-values-text",
          "public.shell-script",
          "public.python-script"
        ]
      },
      {
        "ext": [
          "md",
          "markdown",
          "mdx"
        ],
        "name": "Markdown",
        "description": "Markdown document",
        "role": "Editor",
        "rank": "Alternate",
        "mimeType": "text/markdown"
      },
      {
        "ext": [
          "json",
          "jsonc",
          "json5"
        ],
        "name": "JSON",
        "description": "JSON data",
        "role": "Editor",
        "rank": "Alternate",
        "mimeType": "application/json"
      },
      {
        "ext": [
          "yaml",
          "yml"
        ],
        "name": "YAML",
        "description": "YAML configuration",
        "role": "Editor",
        "rank": "Alternate",
        "mimeType": "application/yaml"
      },
      {
        "ext": [
          "toml"
        ],
        "name": "TOML",
        "description": "TOML configuration",
        "role": "Editor",
        "rank": "Alternate",
        "mimeType": "application/toml"
      },
      {
        "ext": [
          "ini",
          "cfg",
          "conf",
          "env",
          "properties",
          "editorconfig",
          "gitignore"
        ],
        "name": "Config",
        "description": "Configuration file",
        "role": "Editor",
        "rank": "Alternate"
      },
      {
        "ext": [
          "csv"
        ],
        "name": "CSV",
        "description": "Comma-separated values",
        "role": "Editor",
        "rank": "Alternate",
        "mimeType": "text/csv"
      },
      {
        "ext": [
          "tsv"
        ],
        "name": "TSV",
        "description": "Tab-separated values",
        "role": "Editor",
        "rank": "Alternate",
        "mimeType": "text/tab-separated-values"
      },
      {
        "ext": [
          "js",
          "mjs",
          "cjs",
          "jsx"
        ],
        "name": "JavaScript",
        "description": "JavaScript source",
        "role": "Editor",
        "rank": "Alternate",
        "mimeType": "text/javascript"
      },
      {
        "ext": [
          "ts",
          "tsx",
          "mts",
          "cts"
        ],
        "name": "TypeScript",
        "description": "TypeScript source",
        "role": "Editor",
        "rank": "Alternate"
      },
      {
        "ext": [
          "rs",
          "py",
          "java",
          "go",
          "rb",
          "php",
          "swift",
          "kt",
          "kts",
          "c",
          "h",
          "cpp",
          "cc",
          "hpp",
          "cs",
          "lua",
          "sql",
          "sh",
          "bash",
          "zsh",
          "fish",
          "dockerfile"
        ],
        "name": "Source code",
        "description": "Source code",
        "role": "Editor",
        "rank": "Alternate"
      },
      {
        "ext": [
          "html",
          "htm",
          "css",
          "scss",
          "less",
          "xml",
          "svg"
        ],
        "name": "Web",
        "description": "Web document",
        "role": "Editor",
        "rank": "Alternate"
      }
    ]
  },
  "plugins": {
    "updater": {
      "active": true,
      "endpoints": [
        "https://octopush.sh/update/latest.json",
        "https://github.com/octopush-sh/octopush/releases/latest/download/latest.json"
      ],
      "dialog": false,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDIzODNDMjlCMkY1MzREODUKUldTRlRWTXZtOEtESXhHMnVxMTI0czA2dVg5SWNCdnhTdWdaVlg4VDBqbWdQc1FQQXB0NU9lYWsK"
    }
  }
}
